#!/usr/bin/env bash

# git mergetool passes: BASE LOCAL REMOTE MERGED.
# diffview expects: {output} [{base}] {left} {right}
if [ "$#" -eq 4 ]; then
  set -- "$4" "$1" "$2" "$3"
fi

# Quote args safely for nvim
args=$(printf ' "%q"' "$@")

if [ "$#" -eq 2 ]; then
  exec nvim -f -c "DiffviewDiffFiles$args"
else
  exec nvim -f -c "DiffviewMergeFiles$args"
fi
