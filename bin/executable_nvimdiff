#!/usr/bin/env bash

# diffs.nvim mergetool: git passes BASE LOCAL REMOTE MERGED, but diffs.nvim
# only wants the merged working file — it detects conflict markers itself.
if [ "$#" -ge 3 ]; then
  set -- "${@: -1}"   # keep only the last arg ($MERGED)
fi

# %q quotes each arg safely (spaces, quotes, globs).
args=$(printf ' "%q"' "$@")

if [ "$#" -eq 2 ]; then
  # Plain two-file diff (difftool / manual, no VCS involved): :Diff files
  exec nvim -f -c "Diff files$args"
else
  # Mergetool / single file: conflict markers are detected by diffs.nvim.
  exec nvim -f "$@"
fi