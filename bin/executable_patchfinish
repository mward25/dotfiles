#!/bin/bash

>&2 echo "Printing patch contents for manual verification"
diff -ura src.orig src.new --color


>&2 printf "Did the patch look good? [y/n]"
read confirm
[ "${confirm}" = "y" ] || exit 0

>&2 echo "Writing patch, what should we call it? "

read patch_name

>&2 echo "Great, writing '${patch_name}.patch'"

diff -ura src.orig src.new > "${patch_name}.patch"

>&2 echo "To apply this patch, add the folowing to the prepare section of your pkgbuild:"
>&2 echo "patch --strip=1 --input=../${patch_name}.patch"
>&2 echo "Also, don't forget to add ${patch_name}.patch to your src array, and to add '' to your checksums, and then to run updpkgsums"
