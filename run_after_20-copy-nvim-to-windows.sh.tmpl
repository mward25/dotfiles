#!/usr/bin/env bash
# On native Windows, Neovim expects its config at %LOCALAPPDATA%\nvim.
# Chezmoi can only place it at ~/.config/nvim (Linux) / %APPDATA%\nvim (Windows).
# This script mirrors the applied config to the Windows location after each apply.
{{ if eq .chezmoi.os "windows" }}
set -euo pipefail

source_config="$(cygpath -u "$APPDATA")/nvim"
target_config="$(cygpath -u "$LOCALAPPDATA")/nvim"
backup_dir="$(cygpath -u "$USERPROFILE")/old_config"

if [[ -d "$source_config" ]]; then
    if [[ -e "$target_config" ]]; then
        mkdir -p "$backup_dir"
        timestamp=$(date +%Y%m%d%H%M%S)
        mv "$target_config" "$backup_dir/nvim-$timestamp"
    fi
    mkdir -p "$target_config"
    cp -R "$source_config"/. "$target_config/"
fi
{{ end }}
